# Weeple backend — copy to .env and adjust

APP_NAME=Weeple AI OS API
APP_ENV=development
API_PREFIX=/api/v1
DEBUG=true

# CORS — comma-separated origins (frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (used when USE_DATABASE=true)
# Postgres:
DATABASE_URL=postgresql+psycopg://weeple:weeple@localhost:5432/weeple
# SQLite alternative when Docker is unavailable:
# DATABASE_URL=sqlite+pysqlite:///./weeple.db

# Auth
JWT_SECRET=change-me-in-production-use-32b+
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=weeple
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:8000/api/v1

# Adapter endpoints (docker-compose service names on the host)
NANGO_URL=http://localhost:3003
MCP_GATEWAY_URL=http://localhost:8080
MEMORY_SERVICE_URL=http://localhost:8420
AGENT_HARNESS_URL=http://localhost:3080
ASTRBOT_URL=http://localhost:6185
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-v4-pro

# Sidecar modes: mock | live  (Compose real images use live)
HARNESS_MODE=live
ASTRBOT_MODE=live
NANGO_MODE=live
MEMORY_MODE=live
MCP_GATEWAY_MODE=mock
SIDECAR_HEALTH_TIMEOUT_SECONDS=3.0

# Required by Nango Connect UI. Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
NANGO_ENCRYPTION_KEY=

# Feature flags
# USE_DATABASE=false keeps everything in memory (no migrations needed).
# USE_DATABASE=true requires `alembic upgrade head` first.
USE_DATABASE=false
# When true, seed demo goals/tasks/activity for local/dev.
# Set false for a clean product store (catalog/sources still seed).
USE_MOCK_DATA=true

# Copy this file to .env (gitignored) and set the real key there.
# Never put secrets in this example file.
DEEPSEEK_API_KEY=
NANGO_SECRET_KEY=
NANGO_CONNECT_URL=http://localhost:3009

# Telegram live connect + send (never commit the real token).
# 1. Talk to @BotFather, create a bot, copy the token into backend/.env
# 2. Optional: after logging into http://localhost:6185, paste dashboard JWT here
# 3. POST /api/v1/messaging/messages with threadId = Telegram chat id
TELEGRAM_BOT_TOKEN=
ASTRBOT_DASHBOARD_TOKEN=
