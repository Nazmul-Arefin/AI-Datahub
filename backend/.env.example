# Weeple backend — copy to .env and adjust

APP_NAME=Weeple AI OS API
APP_ENV=development
API_PREFIX=/api/v1
DEBUG=true

# CORS — comma-separated origins (frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (used when USE_DATABASE=true)
# Postgres:
DATABASE_URL=postgresql+psycopg://weeple:weeple@localhost:5432/weeple
# SQLite alternative when Docker is unavailable:
# DATABASE_URL=sqlite+pysqlite:///./weeple.db

# Auth
JWT_SECRET=change-me-in-production-use-32b+
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=weeple
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:8000/api/v1

# Adapter endpoints (docker-compose service names)
NANGO_URL=http://localhost:3003
MCP_GATEWAY_URL=http://localhost:8080
MEMORY_SERVICE_URL=http://localhost:8081
AGENT_HARNESS_URL=http://localhost:8082
ASTRBOT_URL=http://localhost:8083
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Feature flags
# USE_DATABASE=false keeps everything in memory (no migrations needed).
# USE_DATABASE=true requires `alembic upgrade head` first.
USE_DATABASE=false
USE_MOCK_DATA=true
